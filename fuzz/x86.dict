# x86/x64 instruction prefixes
prefix_opsz="\x66"
prefix_repne="\xf2"
prefix_rep="\xf3"
prefix_addrsz="\x67"
prefix_fs="\x64"
prefix_gs="\x65"
prefix_rexw="\x48"
prefix_rex="\x40"
prefix_2byte="\x0f"

# Stack ops
push_eax="\x50"
push_ecx="\x51"
push_edx="\x52"
push_ebx="\x53"
push_esp="\x54"
push_ebp="\x55"
pop_eax="\x58"
pop_ecx="\x59"
pop_ebp="\x5d"

# Arithmetic
add_rm_r="\x01"
add_r_rm="\x03"
sub_rm_r="\x29"
sub_r_rm="\x2b"
xor_rm_r="\x31"
xor_r_rm="\x33"
cmp_rm_r="\x39"
cmp_r_rm="\x3b"
arith_imm8="\x83"
arith_imm32="\x81"
grp3="\xf7"

# Moves
mov_rm_r="\x89"
mov_r_rm="\x8b"
lea="\x8d"
mov_eax_imm="\xb8"
mov_rm_imm="\xc7"

# Control flow
call_rel32="\xe8"
jmp_rel32="\xe9"
jmp_rel8="\xeb"
ret="\xc3"
ret_imm="\xc2"
jz="\x74"
jnz="\x75"
jb="\x72"
jae="\x73"
jle="\x7e"
jg="\x7f"

# String ops
movsb="\xa4"
movsd="\xa5"
cmpsb="\xa6"
cmpsd="\xa7"
stosb="\xaa"
stosd="\xab"
lodsb="\xac"
lodsd="\xad"
scasb="\xae"
scasd="\xaf"

# Misc
nop="\x90"
int3="\xcc"
int80="\xcd\x80"
syscall="\x0f\x05"
sysenter="\x0f\x34"
cld="\xfc"
std="\xfd"
clc="\xf8"
stc="\xf9"

# ModR/M common
modrm_c0="\xc0"
modrm_c8="\xc8"
modrm_e0="\xe0"
modrm_00="\x00"
sib_esp="\x04\x24"

# Two-byte opcodes
movzx8="\x0f\xb6"
movzx16="\x0f\xb7"
movsx8="\x0f\xbe"
movsx16="\x0f\xbf"
imul="\x0f\xaf"
jz32="\x0f\x84"
jnz32="\x0f\x85"
cmovb="\x0f\x42"
cmove="\x0f\x44"
cmovne="\x0f\x45"
cpuid="\x0f\xa2"
